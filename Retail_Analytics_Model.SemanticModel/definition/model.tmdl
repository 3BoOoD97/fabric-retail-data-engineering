model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectQuery to AS - Retail_Semantic_Model","RetailSalesEvents"]

annotation PBI_ProTooling = ["WebModelingEdit"]

ref table dim_customer
ref table dim_product
ref table dim_date
ref table fact_sales
ref table 'Metric Selector '
ref table 'Time Intelligence'
ref table RetailSalesEvents
ref table 'Metric Selector Local'

ref cultureInfo en-US

