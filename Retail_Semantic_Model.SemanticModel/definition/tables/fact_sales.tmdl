	measure 'Total Revenue' =
			
			SUM(fact_sales[NetAmount])
		lineageTag: df8eceee-c5cf-4b70-8ee5-c0212f710c37

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Profit' =
			
			SUM(fact_sales[ProfitAmount])
		lineageTag: d920aec5-7f36-4de2-b08d-1c8da5b9ea2c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Units' =
			
			SUM(fact_sales[Quantity])
		formatString: 0
		lineageTag: b788264b-1d4f-423f-b149-9e9e9b59aae4

		changedProperty = Name

	measure 'Margin %' =
			
			VAR _Revenue = [Total Revenue]
			VAR _Profit = [Total Profit]
			RETURN
			    DIVIDE(_Profit, _Revenue)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e765f244-0c78-44b6-beee-21ea30b756a0

		changedProperty = Name

