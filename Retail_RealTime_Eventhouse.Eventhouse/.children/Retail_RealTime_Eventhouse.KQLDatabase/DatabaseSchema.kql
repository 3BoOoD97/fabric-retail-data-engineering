// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.


.create-merge table RetailSalesEvents (OrderID:string, EventTime:datetime, CustomerID:string, ProductID:string, ProductName:string, CategoryName:string, Quantity:int, UnitPrice:real, DiscountRate:real, NetAmount:real, EventID:string, OrderLineID:string) 
.alter table RetailSalesEvents policy retention @'{"SoftDeletePeriod":"30.00:00:00","Recoverability":"Enabled"}'
